def build_for(goos, goarch, output)
  old_goos = ENV["GOOS"]
  old_goarch = ENV["GOARCH"]
  ENV["GOOS"] = goos
  ENV["GOARCH"] = goarch
  ldflags = goos == "windows" ? "-s -w -H=windowsgui" : "-s -w"
  sh "go build -ldflags '#{ldflags}' -o #{output}"
ensure
  ENV["GOOS"] = old_goos
  ENV["GOARCH"] = old_goarch
end

task :default => [:build, :test]

task :build => [:build_current]

task :build_current do
  host = RUBY_PLATFORM
  arch = host.match?(/arm64|aarch64/) ? "arm64" : "amd64"
  if host.match?(/darwin/)
    build_for("darwin", arch, "ZombieBuddyInstaller-macos-#{arch}")
  elsif host.match?(/linux/)
    build_for("linux", arch, "ZombieBuddyInstaller-linux-#{arch}")
  else
    build_for("windows", "amd64", "ZombieBuddyInstaller.exe")
  end
end

task :build_windows do
  build_for("windows", "amd64", "ZombieBuddyInstaller.exe")
end

task :build_linux do
  build_for("linux", "amd64", "ZombieBuddyInstaller-linux-amd64")
end

task :build_macos do
  build_for("darwin", "arm64", "ZombieBuddyInstaller-macos-arm64")
end

task :build_all do
  Rake::Task[:build_windows].invoke
  Rake::Task[:build_linux].invoke
  Rake::Task[:build_macos].invoke
end

task :test do
  sh "go test ./..."
end
