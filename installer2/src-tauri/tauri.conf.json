{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZombieBuddy Installer",
  "version": "26.11.3",
  "mainBinaryName": "ZombieBuddyInstaller-26.11.3",
  "identifier": "io.github.ipatavatsizz.zbinstaller2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZombieBuddy Installer 26.11.3",
        "width": 680,
        "height": 540,
        "minWidth": 560,
        "minHeight": 480,
        "resizable": true,
        "visible": false,
        "center": true,
        "focus": true
      },
      {
        "label": "diagnostics",
        "title": "ZombieBuddy Installer Diagnostics",
        "url": "diagnostics.html",
        "width": 760,
        "height": 560,
        "minWidth": 620,
        "minHeight": 460,
        "visible": false,
        "center": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "ipatavatsizz",
    "copyright": "Copyright © 2026 ipatavatsizz",
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
