{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZombieBuddy Installer 2",
  "version": "0.1.0",
  "identifier": "io.github.ipatavatsizz.zbinstaller2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "ZombieBuddy Installer 4.5.1", "width": 480, "height": 400, "minWidth": 450, "minHeight": 360, "maxWidth": 480, "maxHeight": 400, "resizable": false, "visible": false, "center": true, "focus": true },
      { "label": "diagnostics", "title": "ZombieBuddy Installer Diagnostics", "url": "diagnostics.html", "width": 760, "height": 560, "minWidth": 620, "minHeight": 460, "visible": false, "center": true, "focus": false }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"] }
}
